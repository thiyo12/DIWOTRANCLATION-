# Ssaaxcy Solutions — production environment
# Copy to `.env` on the server and fill in real values.

# REQUIRED in production: a strong, unique admin password.
# The app refuses to start in production without it.
ADMIN_PASSWORD=change-me-to-a-very-long-random-password

# Set to "production" on the live server (enables HSTS + secure cookies).
NODE_ENV=production

# Port. Leave empty on shared hosting — the host assigns one via PORT.
PORT=

# Base URL of the site (used in confirmation emails), e.g. https://ssaaxcy.ch
# Optional for now.
BASE_URL=

# Recommended: keep SMTP credentials in server environment instead of Admin/database.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: override the SQLite database path (use a persistent volume in production).
DB_PATH=
